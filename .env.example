# Postgres (Neon via the Vercel Marketplace). Pooled URL for the app.
DATABASE_URL=
# Optional: direct (unpooled) Neon URL, used by drizzle-kit migrations if set.
DATABASE_URL_UNPOOLED=

# Public site URL, used for metadataBase and OG image URLs. No trailing slash.
NEXT_PUBLIC_SITE_URL=

# Vercel Blob store for screenshots.
BLOB_READ_WRITE_TOKEN=

# Cloudflare Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis (rate limiting).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Long random string. IPs are stored only as SHA-256(ip + IP_HASH_SALT).
IP_HASH_SALT=

# Long random string (12+ characters) to sign in at /admin.
ADMIN_TOKEN=

# Local development only: set to 1 to save screenshots to .local-uploads/
# when BLOB_READ_WRITE_TOKEN is empty. Leave empty on Vercel.
LOCAL_UPLOADS=
